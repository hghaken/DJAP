// Icon and version information of DJAP.exe (the manifest is added by CMake from app.manifest).
#include <winres.h>
#include "version.h"
#include "resource.h"

IDI_APP ICON "../../assets/DJAP.ico"
IDR_LOGO RCDATA "../../assets/logo.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AP_VERSION_MAJOR, AP_VERSION_MINOR, AP_BUILD_NUMBER, 0
 PRODUCTVERSION AP_VERSION_MAJOR, AP_VERSION_MINOR, AP_BUILD_NUMBER, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DJAP (DJ Audio Processor) - two-deck loudness and dynamics processor"
            VALUE "FileVersion", AP_VERSION_STRING
            VALUE "InternalName", "DJAP"
            VALUE "LegalCopyright", "GPL-3.0"
            VALUE "OriginalFilename", "DJAP.exe"
            VALUE "ProductName", "DJAP (DJ Audio Processor)"
            VALUE "ProductVersion", AP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
