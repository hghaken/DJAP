// Version information, the icon (the preset window's) and the About window's logo of the plug-in DLL (the manifest is added by CMake from
// plugin.manifest).
#include <winres.h>
#include "version.h"
#include "resource.h"

IDI_APP ICON "../../assets/DJAP.ico"
IDR_LOGO RCDATA "../../assets/logo.png"
IDR_VST_LOGO RCDATA "../../assets/vst-compatible-logo.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AP_VERSION_MAJOR, AP_VERSION_MINOR, AP_BUILD_NUMBER, 0
 PRODUCTVERSION AP_VERSION_MAJOR, AP_VERSION_MINOR, AP_BUILD_NUMBER, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DJAP (DJ Audio Processor) - plug-in for DJ software"
            VALUE "FileVersion", AP_VERSION_STRING
            VALUE "InternalName", "DJAP"
            VALUE "LegalCopyright", "Copyright (C) 2026 hghaken. GPL-3.0-or-later."
            VALUE "OriginalFilename", "DJAP.vst3"
            VALUE "ProductName", "DJAP (DJ Audio Processor)"
            VALUE "ProductVersion", AP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
